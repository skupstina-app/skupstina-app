{
  "name": "skupstina",
  "main": "src/worker.js",
  "build": { "command": "node build.mjs" },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "skupstina.app",
      "zone_name": "skupstina.app",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.skupstina.app",
      "zone_name": "skupstina.app",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "exports": {
    "ChatRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatRoom"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "44a83a33-3c42-4a4d-8dde-919307728955"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "619506136474-3cs6s3l31bjpj7r8458m1elojvqvn7nl.apps.googleusercontent.com",
    "ADMIN_EMAILS": "skupstinaapp@gmail.com,mgrahovac87@gmail.com,iva.galicru@gmail.com",
    "LAUNCHED": "1",
    "PAGE_V": "5"
  }
}